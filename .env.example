# Copy to .env.local. Never commit real secrets.
APP_URL=http://127.0.0.1:3000
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Local SQLite file; use libsql://YOUR-DB.turso.io and auth token in production.
DATABASE_URL=file:data/reality.db
DATABASE_AUTH_TOKEN=
# Private disk storage; production requires a persistent volume, or private S3.
EVIDENCE_DRIVER=local
EVIDENCE_DIR=data/evidence
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# 0G OpenAI-compatible Router; no simulated successful inference.
OG_API_KEY=
OG_BASE_URL=https://router-api.0g.ai/v1
OG_MODEL=qwen2.5-vl-72b-instruct
# verified routing does not imply private hardware-isolated inference.
# private fails closed when no private multimodal provider is available.
OG_TRUST_MODE=private
# Hedera native HBAR: 100,000 tinybars = 0.001 HBAR. Testnet only.
X402_FACILITATOR_URL=https://x402.org/facilitator
HEDERA_MERCHANT_ACCOUNT_ID=
HEDERA_BUYER_ACCOUNT_ID=
HEDERA_BUYER_PRIVATE_KEY=
AGENT_MAX_PER_PURCHASE_TINYBARS=1000000
AGENT_TOTAL_BUDGET_TINYBARS=10000000
# Bearer token protects server wallet; >=32 random characters. Never NEXT_PUBLIC.
AGENT_API_TOKEN=
# World ID 4.x: register app/RP in developer.world.org.
WORLD_APP_ID=
WORLD_RP_ID=
WORLD_RP_SIGNING_KEY=
WORLD_ACTION=claim-mission
# staging = simulator; always visibly labeled. Use production for real World ID.
WORLD_ENVIRONMENT=staging
